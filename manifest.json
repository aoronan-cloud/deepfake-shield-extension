{
  "manifest_version": 3,
  "name": "Shield: Deepfake & AI Detector",
  "version": "1.0.0",
  "description": "Proteção preventiva e em tempo real contra deepfakes e clonagem de voz em videoconferências. 100% local e open-source.",
  "author": "Sua Empresa / Seu Nome",
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://meet.google.com/*",
    "*://teams.microsoft.com/*",
    "*://teams.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*"
      ],
      "js": ["dist/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/models/*"
      ],
      "matches": [
        "*://meet.google.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shield-detector@sua-extensao.com",
      "strict_min_version": "109.0"
    }
  }
}
