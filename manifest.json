{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "Sua Empresa / Seu Nome",
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://meet.google.com/*",
    "*://teams.microsoft.com/*",
    "*://teams.live.com/*",
    "*://app.zoom.us/*",
    "*://web.whatsapp.com/*",
    "*://discord.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://app.zoom.us/*",
        "*://web.whatsapp.com/*",
        "*://discord.com/*"
      ],
      "js": ["dist/content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://meet.google.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://app.zoom.us/*",
        "*://web.whatsapp.com/*",
        "*://discord.com/*"
      ],
      "js": ["dist/webrtc_hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shield-detector@sua-extensao.com",
      "strict_min_version": "109.0"
    }
  }
}
